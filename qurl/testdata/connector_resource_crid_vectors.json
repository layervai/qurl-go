{
  "artifact": "qurl-connector-resource-lst-v1-vectors",
  "schema_version": 1,
  "description": "Byte-exact registered-agent NHP_LST/NHP_LRT application contract for resolving or idempotently creating one qURL Connector resource without customer-runtime HTTP.",
  "notes": [
    "This application profile begins only after assigned-cell registration. Unlike pre-registration assignment and completion requests, usrId and devId are both the final agent_id and must match the agent identity independently mapped from the Noise-authenticated static key.",
    "The request is sent directly to the pinned assigned cell. It never uses the public assignment Hub, Hub cookie, relay fallback, or an HTTP fallback.",
    "One LST resolves exactly one connector_id. Multi-route runtimes perform one exchange per route so each LRT remains inside the operational unfragmented budget.",
    "expected_crid is a read-only continuity assertion. The Authority returns that exact active resource or resource_identity_conflict; an absent, revoked, tombstoned, or different resource must not be created, reclaimed, or substituted.",
    "The CSPRNG request_nonce is minted once per logical operation. Exact replay under the same authenticated peer returns the byte-identical first result, including found_existing=false; changed semantics under the same replay key fail before mutation.",
    "crid is required and must be a locally valid CRID whose delivered-key binding matches resource_public_key.",
    "A persisted resource binding is routing continuity, not authorization. Every tunnel cycle still sends NHP_KNK for knock_resource_id and relies on live ASP authorization plus the authenticated ACK.",
    "The body size_budget_bytes field is a conservative pre-seal accounting value, not a packet golden. The NHP reference codec owns the real encrypted-packet proof that every accepted result remains at or below 1232 bytes."
  ],
  "contract": {
    "query": "connector_resource",
    "version": 1,
    "request_header_name": "NHP_LST",
    "request_header_type": 5,
    "result_header_name": "NHP_LRT",
    "result_header_type": 6,
    "asp_id": "agent",
    "request_outer_fields": ["usrId", "devId", "aspId", "usrData"],
    "request_user_data_required_fields": ["query", "version", "request_nonce", "connector_id"],
    "request_user_data_optional_fields": ["expected_crid"],
    "success_outer_fields": ["errCode", "list"],
    "success_list_required_fields": ["query", "version", "agent_id", "connector_id", "resource_public_key", "connector_routing_id", "knock_resource_id", "crid", "found_existing"],
    "success_list_optional_fields": [],
    "error_required_fields": ["errCode", "errMsg"],
    "error_optional_fields": ["retryAfterSeconds"],
    "nonce_encoding": "canonical_base64url_unpadded",
    "nonce_decoded_bytes": 32,
    "agent_id_pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$",
    "connector_id_pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$",
    "resource_public_key_encoding": "canonical_base64url_unpadded_p256_der_spki",
    "resource_public_key_decoded_bytes": 91,
    "resource_public_key_encoded_chars": 122,
    "connector_routing_id_pattern": "^c-[a-z2-7]{52}$",
    "knock_resource_id_max_bytes": 64,
    "crid_profile": "qurl-crid-v1-vectors_required_and_must_match_resource_public_key",
    "identity_source": "noise_authenticated_registered_agent_key_mapped_to_exact_usrId_and_devId",
    "entitlement_source": "server_side_owner_and_enrollment_connector_claim_never_client_supplied",
    "one_resource_per_exchange": true,
    "http_fallback_allowed": false,
    "expected_crid_rule": "optional_read_only_continuity_assertion_exact_active_match_only_else_terminal_52503_for_absent_revoked_tombstoned_or_different_resource_never_create_or_reclaim",
    "exact_replay_rule": "same_authenticated_peer_query_request_nonce_and_exact_semantic_body_returns_byte_identical_result",
    "changed_replay_rule": "same_replay_key_changed_semantics_returns_52506_before_authority_or_mutation",
    "later_request_rule": "fresh_nonce_reexecutes_authoritative_resolve_and_reports_current_found_existing",
    "found_existing_rule": "fresh_create_false_exact_replay_preserves_false_later_fresh_nonce_for_same_active_resource_true",
    "authorization_freshness_rule": "persisted_binding_never_bypasses_each_knock_authorization_or_resource_lifecycle_check",
    "conservative_overhead_bytes": 256,
    "size_accounting_rule": "plaintext_body_bytes_plus_256_conservative_preseal_budget_not_packet_golden",
    "real_seal_proof_owner": "NHP_reference_codec_integration_test",
    "max_plaintext_body_bytes": 976,
    "max_packet_bytes": 1232,
    "max_retry_after_seconds": 3600,
    "reject_classes": ["body_parse", "unknown_field", "missing_field", "wrong_type", "semantic", "agent_binding", "request_binding", "resource_binding", "crid_binding", "list_on_error", "retry_after_missing", "retry_after_invalid", "retry_after_unexpected", "unknown_error_code", "packet_size"],
    "error_codes": ["52500", "52501", "52502", "52503", "52504", "52505", "52506"]
  },
